# Octofit Tracker Environment Configuration
#
# Copy this file to .env.local and update the values for your environment
#
# For GitHub Codespaces:
# 1. Find your codespace name in the URL or in GitHub settings
# 2. The format is typically: adjective-animal-randomid
# Example: glorious-space-guacamole-pjvwv64j4rggfrww9

# Codespace name - REQUIRED for production URLs
# Used to construct: https://${VITE_CODESPACE_NAME}-8000.app.github.dev/api
# If not set, falls back to http://localhost:8000/api
VITE_CODESPACE_NAME=your-codespace-name-here
